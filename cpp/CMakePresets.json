{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "host-system",
            "displayName": "Host build (system dependencies)",
            "description": "Build and install the library using C++ dependencies already installed on the system. Does not use Conan and does not build tests. Used on machines that have the dependencies but not Conan.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "test-system",
            "displayName": "Test build (system dependencies)",
            "description": "Build with the unit tests enabled using Conan-provided dependencies. Used by CI to build and run the test suite.",
            "inherits": "base",
            "cacheVariables": {
                "CUCUMBER_MESSAGES_BUILD_TESTS": "On",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "host-conan",
            "displayName": "Host build (Conan dependencies)",
            "description": "Build and install the library using Conan-provided dependencies. Requires 'conan install --output-folder=build/host-conan' first. Used by CI. Does not build tests.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/${presetName}/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "test-conan",
            "displayName": "Test build (automatic Conan)",
            "description": "Build and install the library using Conan-provided dependencies. Used by CI. Does not build tests.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/conan_provider.cmake",
                "CUCUMBER_MESSAGES_BUILD_TESTS": "On",
                "CMAKE_BUILD_TYPE": "Debug",
                "CONAN_INSTALL_ARGS": "--build=missing"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-system",
            "configurePreset": "host-system"
        },
        {
            "name": "test-system",
            "configurePreset": "test-system"
        },
        {
            "name": "host-conan",
            "configurePreset": "host-conan"
        },
        {
            "name": "test-conan",
            "configurePreset": "test-conan"
        }
    ],
    "testPresets": [
        {
            "name": "test-system",
            "configurePreset": "test-system",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-conan",
            "configurePreset": "test-conan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "host-system",
            "steps": [
                {
                    "name": "host-system",
                    "type": "configure"
                },
                {
                    "name": "host-system",
                    "type": "build"
                }
            ]
        },
        {
            "name": "test-system",
            "steps": [
                {
                    "name": "test-system",
                    "type": "configure"
                },
                {
                    "name": "test-system",
                    "type": "build"
                },
                {
                    "name": "test-system",
                    "type": "test"
                }
            ]
        },
        {
            "name": "host-conan",
            "steps": [
                {
                    "name": "host-conan",
                    "type": "configure"
                },
                {
                    "name": "host-conan",
                    "type": "build"
                }
            ]
        },
        {
            "name": "test-conan",
            "steps": [
                {
                    "name": "test-conan",
                    "type": "configure"
                },
                {
                    "name": "test-conan",
                    "type": "build"
                },
                {
                    "name": "test-conan",
                    "type": "test"
                }
            ]
        }
    ]
}
